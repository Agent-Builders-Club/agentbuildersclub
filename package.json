{
  "name": "agent-builders-club",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local --config scripts/static-cache-local.json && node scripts/static-cache-e2e.mjs --artifact-only",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "format:check": "prettier --check package.json tsconfig.json .github/workflows/ci.yml",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:coverage": "node scripts/coverage-baseline.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:api-db-e2e": "node scripts/d1-api-e2e.mjs",
    "test:d1-e2e": "node scripts/d1-api-e2e.mjs",
    "test:runner": "node --test tests/*.test.mjs",
    "test:duplicate-policy": "node scripts/duplicate-policy-e2e.mjs",
    "test:maintenance": "node scripts/maintenance-e2e.mjs --disposable",
    "test:cleanup-e2e": "node scripts/site-cleanup-e2e.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "next": "15.5.27",
    "nodemailer": "10.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "knip": "^6.4.1",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "8.0.16",
    "vitest": "^4.1.11",
    "wrangler": "4.149.0"
  }
}
