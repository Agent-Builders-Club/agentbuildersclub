    "start": "next start",
    "lint": "eslint",
    "format:check": "prettier --check package.json tsconfig.json .github/workflows/ci.yml",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run --passWithNoTests",
    "test:cf-credentials": "node --test scripts/check-opennext-credentials.test.mjs",
    "test:coverage": "node scripts/coverage-baseline.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:api-db-e2e": "node scripts/api-db-e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
