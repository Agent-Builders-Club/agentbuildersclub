  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-next.mjs",
    "build:cf": "node scripts/check-opennext-credentials.mjs && OPENNEXT_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
