{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abc-feed-foundation-local-only",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "abc-feed-local-placeholder-do-not-deploy",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "migrations"
  }]
}
