# Migration target only. Read docs/cloudflare-migration.md before use.
# DB is the server-side D1 binding in wrangler.jsonc, NOT a dotenv credential.
# Do not add Supabase URL/anon/service keys or browser database credentials.
NEXT_PUBLIC_BASE_URL=https://www.agentbuildersclub.dev

# Server-only admin secret. Keep the existing name for API compatibility.
# Replace locally through approved secret management; never commit real values.
CLAWPLEX_ADMIN_API_KEY=replace-with-local-admin-secret

# Contact recipient is configured in wrangler.jsonc.
CONTACT_TO_EMAIL=hello@agentbuildersclub.dev
# Contact notifications use the existing Zoho SMTP account over verified TLS.
# Select the host shown in Zoho Mail Accounts settings; no new paid service.
SMTP_HOST=smtp.zoho.com
SMTP_USER=hello@agentbuildersclub.dev
SMTP_PASSWORD=
# SMTP_PASSWORD is server-only. Use an app password when Zoho requires one.
# Keep it in protected local configuration / Worker secrets, never source or chat.
# SMTP acceptance and inbox receipt must be verified before release.
# Use ignored .dev.vars for Wrangler-local secrets; deployed secrets use Wrangler.
